# Rust build artifacts
/target
**/*.rs.bk
Cargo.lock.bak

# Generated by `wasm-pack build` / scripts/build_wasm.bash. The deploy
# workflow builds web/asset/js/wasm/ from source on every run; it is
# never committed.
**/*.wasm
**/*.d.ts
/web/asset/js/wasm/
/crates/wasm/pkg/

# IDE files
.idea/
.vscode/
*.iml
*.swp
.DS_Store

# Editor / OS noise
*~
*.tmp
*.bak

# Web server state
.ftpquota

# Old binary artifacts in web/ (intentionally not in web/asset/bin any more)
web/asset/bin/
web/asset/bash/

# Local makepkg runs in packaging/aur/
/packaging/aur/src/
/packaging/aur/pkg/
/packaging/aur/*.tar.gz
/packaging/aur/*.pkg.tar.*
